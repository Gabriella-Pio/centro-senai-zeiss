apps/*/.next/
apps/*/dist/
apps/*/out/
apps/*/build/
apps/api/generated/

# Env
.env
.env.local

# Pasta antiga após a mudança para apps/ (só cache do Next)
frontend/

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Diagnostic reports
report.[0-9]*.json

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# AI Assistants & IDE specific folders
.idea/
.vscode/*
